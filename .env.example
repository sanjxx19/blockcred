# =============================================================================
# BlockCred configuration. Copy to .env with `npm run setup` (generates secrets).
# Every service reads this single root .env file.
# =============================================================================

# ---------------------------------------------------------------- blockchain
# Local Hardhat node (default). For Polygon Amoy use CHAIN_ID=80002 and an Amoy RPC.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Written by `npm run deploy:*` (path relative to the repo root).
DEPLOYMENTS_FILE=contracts/deployments/localhost.json
# Alternatively set the addresses explicitly (takes precedence over DEPLOYMENTS_FILE):
ISSUER_REGISTRY_ADDRESS=
REVOCATION_REGISTRY_ADDRESS=
MERKLE_ANCHOR_ADDRESS=
TX_CONFIRMATIONS=1

# ---- Contract deployment (testnets only; local Hardhat uses its built-in accounts)
DEPLOYER_PRIVATE_KEY=
# Defaults to the deployer. In production use a multi-sig (e.g. Safe) address.
ADMIN_ADDRESS=
GOVERNOR_ADDRESSES=
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------- database
DATABASE_URL=postgres://blockcred:blockcred@127.0.0.1:5432/blockcred

# ---------------------------------------------------------------- issuer service
ISSUER_PORT=4000
ISSUER_PUBLIC_URL=http://localhost:4000
# Optional. Defaults to did:web derived from ISSUER_PUBLIC_URL (did:web:localhost%3A4000).
# For GitHub Pages hosting e.g. did:web:<user>.github.io:<repo>
ISSUER_DID=
ISSUER_NAME=Demo Institute of Technology
# JSON array of P-256 signing keys: [{"id":"key-1","status":"active","privateJwk":{...}}]
# Generated by `npm run setup`; rotate with `npm run rotate-issuer-key`.
ISSUER_KEYS=
# ISSUER_KEYS_FILE=secrets/issuer-keys.json
ISSUER_ADMIN_API_KEY=
# Ethereum account that operates the issuer on-chain (anchoring / revocation).
# Default = Hardhat test account #1. PUBLICLY KNOWN KEY - NEVER USE ON A REAL NETWORK.
ISSUER_CONTROLLER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
ISSUER_CONTROLLER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
CREDENTIAL_TTL_DAYS=1825
OFFER_TTL_HOURS=72
PURGE_OFFER_CLAIMS=true
DECOY_DIGESTS=3
STATUS_INDEX_SPACE=1048576
ANCHOR_INTERVAL_SEC=60
ANCHOR_MAX_BATCH=2000
WALLET_URL=http://localhost:5173

# ---------------------------------------------------------------- verifier service
VERIFIER_PORT=5000
VERIFIER_PUBLIC_URL=http://localhost:5000
VERIFIER_NAME=Demo Employer Inc.
VERIFIER_API_KEY=
REQUEST_TTL_SEC=300
RESULT_RETENTION_SEC=3600
REQUIRE_ANCHOR=false
DID_CACHE_TTL_SEC=300
# DEVELOPMENT ONLY (rejected when NODE_ENV=production):
DID_WEB_ALLOW_HTTP_HOSTS=localhost:4000
DID_WEB_HOST_OVERRIDES={}

# ---------------------------------------------------------------- shared
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
NODE_ENV=development

# ---------------------------------------------------------------- web app (Vite, baked in at build time)
VITE_ISSUER_URL=http://localhost:4000
VITE_VERIFIER_URL=http://localhost:5000
# e.g. https://amoy.polygonscan.com/tx/
VITE_EXPLORER_TX_URL=
