# =============================================================================
# BlockCred v2 configuration. Create .env with `npm run setup` (generates secrets).
# =============================================================================

# ---------------------------------------------------------------- accounts
# The accreditation-admin login (created/updated automatically when the API starts).
ADMIN_EMAIL=admin@blockcred.local
ADMIN_PASSWORD=
ADMIN_NAME=National Accreditation Board (demo)
# Encrypts university signing keys and controller keys at rest (32 bytes, base64).
MASTER_ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# ---------------------------------------------------------------- blockchain
# Local Hardhat node (default). Polygon Amoy: CHAIN_ID=80002, RPC_URL=https://rpc-amoy.polygon.technology
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DEPLOYMENTS_FILE=contracts/deployments/localhost.json
ISSUER_REGISTRY_ADDRESS=
REVOCATION_REGISTRY_ADDRESS=
MERKLE_ANCHOR_ADDRESS=
TX_CONFIRMATIONS=1

# Platform governance account: registers/suspends universities on-chain and pays them gas.
# Default = Hardhat test account #0 (also the local deployer).
# PUBLICLY KNOWN KEY - NEVER USE ON A REAL NETWORK. On a testnet use your DEPLOYER_PRIVATE_KEY.
PLATFORM_GOVERNOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Gas money sent to each newly approved university's controller account (use ~0.05 on testnets).
ISSUER_FUNDING_ETH=1

# Contract deployment on testnets (local Hardhat uses its built-in accounts)
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
GOVERNOR_ADDRESSES=
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# ---------------------------------------------------------------- database
DATABASE_URL=postgres://blockcred:blockcred@127.0.0.1:5432/blockcred

# ---------------------------------------------------------------- API
API_PORT=4000
# Public base URL of the API. University DIDs are did:web:<host>:issuers:<slug> under it.
PUBLIC_URL=http://localhost:4000
CREDENTIAL_TTL_DAYS=1825
DECOY_DIGESTS=3
STATUS_INDEX_SPACE=1048576
ANCHOR_INTERVAL_SEC=60
ANCHOR_MAX_BATCH=2000
REQUEST_TTL_HOURS=168
RESULT_RETENTION_HOURS=720
DID_CACHE_TTL_SEC=60
# DEVELOPMENT ONLY (rejected when NODE_ENV=production):
DID_WEB_ALLOW_HTTP_HOSTS=localhost:4000
DID_WEB_HOST_OVERRIDES={}
TRUST_PROXY=loopback, uniquelocal
LOG_LEVEL=info
NODE_ENV=development

# ---------------------------------------------------------------- web app
# Where the Vite dev server forwards /api requests.
API_PROXY_TARGET=http://localhost:4000
# e.g. https://amoy.polygonscan.com/tx/
VITE_EXPLORER_TX_URL=
